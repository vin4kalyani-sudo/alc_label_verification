# Copy to .env and fill in. Never commit .env.

# Database (required for the default profile and docker compose)
DATABASE_URL=jdbc:postgresql://localhost:5432/labelverification
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Bootstrap accounts on an empty database (disable with APP_SEED=false in production)
APP_SEED=true
APP_SEED_PASSWORD=
APP_SEED_SPECIALIST_EMAIL=specialist@example.gov
APP_SEED_APPLICANT_EMAIL=applicant@example.com

# Local OCR paths. Leave blank to auto-detect Homebrew / Debian installs.
TESSDATA_PREFIX=
TESSERACT_LIBRARY_PATH=

# Optional cloud AI. Set BOTH to enable the cloud pipeline.
GOOGLE_VISION_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano

# Where uploaded label images are stored
APP_STORAGE_DIR=./data/uploads

# --- Hosting / sizing (see docs/deploy-railway.md) ---
# SPRING_PROFILES_ACTIVE=railway   # small-container profile: DB image storage, 1 OCR at a time, https proxy
# APP_STORAGE_TYPE=filesystem      # filesystem | database
# OCR_MAX_CONCURRENT=2
# DB_POOL_SIZE=10
# TOMCAT_MAX_THREADS=200
# JAVA_OPTS=                       # container JVM flags (Dockerfile default targets 512 MB)
